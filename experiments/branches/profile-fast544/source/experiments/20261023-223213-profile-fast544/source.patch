diff --git a/supership/pipeline_profile.py b/supership/pipeline_profile.py
new file mode 100644
index 0000000..d366265
--- /dev/null
+++ b/supership/pipeline_profile.py
@@ -0,0 +1,57 @@
+"""Opt-in pipeline diagnosis; CUDA events preserve asynchronous execution."""
+
+from collections import defaultdict
+from contextlib import contextmanager
+import json
+from pathlib import Path
+import threading
+import time
+
+import torch
+
+
+class PipelineProfile:
+    def __init__(self, output):
+        self.output = output
+        self.cpu = defaultdict(float)
+        self.calls = defaultdict(int)
+        self.events = []
+        self.lock = threading.Lock()
+        self.started = time.perf_counter()
+
+    def add(self, name, seconds):
+        with self.lock:
+            self.cpu[name] += seconds
+            self.calls[name] += 1
+
+    @contextmanager
+    def host(self, name):
+        started = time.perf_counter()
+        try:
+            yield
+        finally:
+            self.add(name, time.perf_counter() - started)
+
+    def begin_gpu(self, name, stream=None):
+        start = torch.cuda.Event(enable_timing=True)
+        end = torch.cuda.Event(enable_timing=True)
+        start.record(stream)
+        self.events.append((name, start, end))
+        return end
+
+    def finish(self, images, detections):
+        # Called after the worker's existing final device synchronization/fsync.
+        elapsed = time.perf_counter() - self.started
+        gpu = defaultdict(float)
+        gpu_calls = defaultdict(int)
+        for name, start, end in self.events:
+            gpu[name] += start.elapsed_time(end) / 1000
+            gpu_calls[name] += 1
+        report = dict(
+            wall_seconds=elapsed, images=images, detections=detections,
+            cpu_seconds=dict(self.cpu), cpu_calls=dict(self.calls),
+            gpu_seconds=dict(gpu), gpu_calls=dict(gpu_calls),
+            method='perf_counter host regions and CUDA events, no added per-batch synchronization',
+            caveats='Thread CPU regions are summed wall times, overlap each other and GPU; do not add CPU and GPU columns. Graph covers preprocessing, model and GPU postprocessing. Excludes init, report writing and process exit. Instrumentation adds overhead.',
+        )
+        Path(self.output).write_text(json.dumps(report, indent=2) + '\n')
diff --git a/supership/profile_fast_worker.py b/supership/profile_fast_worker.py
new file mode 100644
index 0000000..2a98d2f
--- /dev/null
+++ b/supership/profile_fast_worker.py
@@ -0,0 +1,50 @@
+"""Trace the fastest worker on real inputs, using the existing READY protocol.
+
+This is a diagnostic worker. Its timings include profiler overhead and must not
+be used as competition performance numbers. Set all normal runtime variables.
+"""
+
+from collections import defaultdict
+import json
+import os
+from pathlib import Path
+import sys
+
+sys.path.insert(0, os.getcwd())
+
+import torch
+
+from supership.fast_worker import Runtime
+from supership.generate_submission import read_worker_request
+
+
+def main():
+    runtime = Runtime()
+    print('THU_RS_READY', flush=True)
+    request = read_worker_request()
+    with torch.profiler.profile(activities=[
+        torch.profiler.ProfilerActivity.CPU,
+        torch.profiler.ProfilerActivity.CUDA,
+    ]) as profiler:
+        detections, images = runtime.run(request)
+    base = Path(request['output_file'])
+    profiler.export_chrome_trace(str(base) + '.trace.json')
+    kernels = defaultdict(lambda: dict(calls=0, microseconds=0.0))
+    for event in profiler.events():
+        if event.device_type == torch.autograd.DeviceType.CUDA:
+            row = kernels[event.name]
+            row['calls'] += 1
+            row['microseconds'] += event.device_time_total
+    rows = [dict(name=name, **data) for name, data in kernels.items()]
+    rows.sort(key=lambda row: row['microseconds'], reverse=True)
+    Path(str(base) + '.kernels.json').write_text(json.dumps(dict(
+        images=images, detections=detections, kernels=rows,
+        caveat='Profiler overhead changes wall time. CUDA kernel sums are not end-to-end percentages.',
+    ), indent=2) + '\n')
+    sys.stdout.flush()
+    sys.stderr.flush()
+    os._exit(0)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/profile_fast544.py b/tools/profile_fast544.py
new file mode 100644
index 0000000..92707be
--- /dev/null
+++ b/tools/profile_fast544.py
@@ -0,0 +1,56 @@
+"""Reproduce baseline, stage timings or CUDA trace with explicit saved config.
+
+Example: python tools/profile_fast544.py --config experiments/ID/config.json
+         --output-dir output/ID/stages --mode stages
+Baseline and stages default to three independent workers; trace defaults to one.
+The official timer and validator are used without modification.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config', required=True)
+    parser.add_argument('--output-dir', required=True)
+    parser.add_argument('--mode', choices=['baseline', 'stages', 'trace'], default='baseline')
+    parser.add_argument('--runs', type=int)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    config = json.loads(Path(args.config).read_text())
+    output = Path(args.output_dir).resolve()
+    output.mkdir(parents=True, exist_ok=False)
+    env = {**os.environ, **config}
+    env.pop('FAST_PROFILE', None)
+    if args.mode == 'stages':
+        env['FAST_PROFILE'] = '1'
+    python = config.get('PYTHON_BIN', sys.executable)
+    runs = args.runs or (1 if args.mode == 'trace' else 3)
+    command = [python, 'supership/benchmark_submission.py',
+               '--image-dir', 'data/SuperShip/reference/images',
+               '--meta-file', 'data/SuperShip/reference/reference_images_meta.json',
+               '--output-file', str(output / 'predictions.json'), '--runs', str(runs), '--']
+    command += ([python, 'supership/profile_fast_worker.py'] if args.mode == 'trace'
+                else ['bash', 'run.sh', '--worker'])
+    (output / 'command.json').write_text(json.dumps(dict(
+        command=command, config=config, cwd=str(root), mode=args.mode,
+    ), indent=2) + '\n')
+    with (output / 'benchmark.log').open('w') as log:
+        subprocess.run(command, cwd=root, env=env, stdout=log, stderr=subprocess.STDOUT, check=True)
+    print((output / 'benchmark.log').read_text())
+    for index in range(1, runs + 1):
+        prediction = output / (f'predictions.run{index}.json' if runs > 1 else 'predictions.json')
+        with (output / f'score{index}.log').open('w') as log:
+            subprocess.run([python, 'supership/score_submission.py', '--gt',
+                            'data/SuperShip/reference/annotations/instances_reference.json',
+                            '--submission', str(prediction)], cwd=root, env=env,
+                           stdout=log, stderr=subprocess.STDOUT, check=True)
+
+
+if __name__ == '__main__':
+    main()
