# Use on exp/rtx4090-e2e for the historical conservative configuration.
export PIPELINE=fast
export PRECISION=fp16
export BACKEND=cuda_graph
export BATCH_SIZE=8
export NUM_WORKERS=8
export PIPELINE_DEPTH=3
export SCORE_THRESHOLD=0.05
export IMAGE_DECODER=opencv
export VECTORIZED_RESULTS=1
export CHANNELS_LAST=1
export MODEL_DEPLOY=0
export FAST_EXIT=1
export TORCH_THREADS=1
export JPEG_REDUCTION=1
export RESIZE_ANTIALIAS=1
export INPUT_SIZE=640
